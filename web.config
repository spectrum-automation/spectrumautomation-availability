<?xml version="1.0" encoding="utf-8"?>
<!-- IIS / iisnode config for Azure App Service on Windows. Every request goes to server.js. -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <!-- Let iisnode's own debugger/log URLs through untouched. -->
        <rule name="iisnode" stopProcessing="true">
          <match url="^server.js\/debug[\/]?" />
        </rule>
        <rule name="app" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="iisnode" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <!-- The app sends its own JSON error bodies (e.g. 401 with the event title); don't replace them. -->
    <httpErrors existingResponse="PassThrough" />
    <!-- Compression buffers responses, which would hold back the Server-Sent Events stream. -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    <!--
      flushResponse: send each write straight to the client so live updates aren't buffered.
      nodeProcessCountPerApplication="1": events and live connections are held in memory, so
      there must be exactly one Node process.
    -->
    <iisnode
      flushResponse="true"
      nodeProcessCountPerApplication="1"
      enableXFF="true"
      watchedFiles="web.config;*.js"
      loggingEnabled="true"
      devErrorsEnabled="false" />
  </system.webServer>
</configuration>
